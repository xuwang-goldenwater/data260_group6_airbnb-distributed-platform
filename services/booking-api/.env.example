# Role B — Booking API + worker. Copy to services/booking-api/.env (git-ignored) and adjust.
# Real environment variables override this file.

# MySQL (infra/docker-compose.yml). Use 3307 if you started compose with
# services/booking-api/infra/compose.mysql-3307.yml because host port 3306 was busy.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=airbnb
MYSQL_PASSWORD=airbnb
MYSQL_DATABASE=airbnb
MYSQL_POOL_SIZE=32

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# JWT verification (HS256). DEV-ONLY placeholder — set your own long random value; never commit it.
JWT_SECRET=replace-with-a-long-random-dev-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=
# Optional shared secret accepted as `X-Service-Token` on /internal/* (in addition to role=service JWTs).
BOOKING_SERVICE_TOKEN=
# Dev-only: POST /dev/token mints test JWTs for the demo page. Keep false outside local demos.
BOOKING_DEV_TOKEN_ENDPOINT=false

# Property lookup: "seed" reads data/seed/generated/properties.json; "http" calls PROPERTY_SERVICE_URL/properties/get
PROPERTY_SOURCE=seed
PROPERTY_SERVICE_URL=
# Optional; when empty or unreachable the dashboards fall back to seed data / null.
USER_SERVICE_URL=
ANALYTICS_SERVICE_URL=
HTTP_TIMEOUT_S=2.0

# API behaviour
BOOKING_PRECHECK_ENABLED=true
BOOKING_RATE_LIMIT_PER_MINUTE=120
# TEST ONLY: spread booking.requested over partitions so several workers race on one property.
BOOKING_TEST_SPREAD_PARTITIONS=false
BOOKING_OUTBOX_INTERVAL_S=2
BOOKING_OUTBOX_MIN_AGE_S=5
BOOKING_COMPLETION_INTERVAL_S=900
BOOKING_WS_ENABLED=true
BOOKING_WS_CONSUMER_GROUP=booking-status
# BOOKING_CLOCK_DATE=2026-12-05   # override "today" (UTC) for demos/tests

# Worker
WORKER_ID=worker-1
WORKER_GROUP=booking-worker
# Fault injection (demos only): crash_after_db_commit
WORKER_FAULT=
# Number of injected transient MySQL errors (deadlock 1213) before real processing (retry demo)
WORKER_TRANSIENT_FAULTS=0
