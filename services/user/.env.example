# Local development only. Copy to services/user/.env (ignored by Git).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=airbnb
MYSQL_PASSWORD=airbnb
MYSQL_DATABASE=airbnb
# Set the same JWT_SECRET on User, Property, Booking and AI. Never commit its value.
JWT_SECRET=
# Optional. If set, all services and tokens must agree on issuer.
JWT_ISSUER=
BOOKING_SERVICE_URL=http://127.0.0.1:8002
USER_SERVICE_URL=http://127.0.0.1:8001
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
HTTP_TIMEOUT_S=3
